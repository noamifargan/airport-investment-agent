# Copy to .env and adjust. Every value is optional.

# Local LLM served by Ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:4b

# 1 = never touch the network; answer from disk cache / bundled snapshot only
OFFLINE=0

# Where cached API responses and built feature tables are stored
AIRPORT_AGENT_DATA_DIR=./data

# HTTP timeout in seconds for public API calls
HTTP_TIMEOUT=60
